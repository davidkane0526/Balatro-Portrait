+local function portrait_scale_hud_tree(node, factor)
+  if type(node) ~= "table" or factor == 1 then return end
+  local config = node.config
+  if type(config) == "table" then
+    for _, key in ipairs({"minw", "maxw", "minh", "maxh", "w", "h", "padding", "r", "emboss", "outline", "line_emboss", "fit_w"}) do
+      if type(config[key]) == "number" then config[key] = config[key] * factor end
+    end
+  end
+  if type(node.nodes) == "table" then
+    for _, child in pairs(node.nodes) do
+      if type(child) == "table" then portrait_scale_hud_tree(child, factor) end
+    end
+  end
+end
