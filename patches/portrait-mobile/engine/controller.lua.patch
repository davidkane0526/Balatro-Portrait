+-- A tap on a card outside the hand leaves its description open, with the finger off
+-- it. In the hand a tap selects the card, and the description is for a held finger.
+local function portrait_keeps_description(self, node)
+    if not (G.F_PORTRAIT and G.SETTINGS.tap_descriptions and self.HID.touch and node and node.is and node:is(Card)) then return false end
+    local kind = node.area and node.area.config and node.area.config.type
+    return kind and kind ~= 'hand' and kind ~= 'deck' and kind ~= 'discard'
+end
+
+-- One left open is there to be touched: a press on it closes it, and doesn't reach a
+-- button it hides (Next Round, in the shop).
+function Controller:portrait_press_on_description()
+    local popup = self.portrait_open_card and self.portrait_open_card.children.h_popup
+    return popup and self.HID.touch and popup:collides_with_point(self.cursor_hover.T)
+end
+
+function Controller:portrait_press_closes_description()
