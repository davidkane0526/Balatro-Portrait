+        self.portrait_open_card = nil
+    end
+end
+
+function Controller:portrait_release_keeps_description()
+    self.portrait_tapped_card = nil
+    if self.clicked.handled then
+        -- A drag or a held finger, not a tap.
+        self.portrait_open_card = nil
+    elseif portrait_keeps_description(self, self.clicked.target) then
+        -- Until the tap is settled, so that the description opening under this
+        -- press does not close for a frame and open again.
+        self.portrait_tapped_card = self.clicked.target
+    end
+end
