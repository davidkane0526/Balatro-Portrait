+-- Under the character is off the screen for one low down (a tablet's Game Over):
+-- there it talks from the side the screen has more of. Asked when it speaks: it
+-- has only then got to its place.
+function Card_Character:portrait_seat_speech_bubble()
+    local sb = self.children.speech_bubble
+    if not (G.F_PORTRAIT and sb and sb.T) then return end
+    local offset = self.config.speech_bubble_align.offset
+    if self.T.y + self.T.h + offset.y + sb.T.h > portrait_screen_bottom() - 0.1 then
+        local left = self.T.x + self.T.w/2 > G.ROOM.T.w/2
+        offset.x, offset.y = left and -0.1 or 0.1, 0
+        sb:set_alignment({major = self, type = left and 'cl' or 'cr', offset = offset})
+        sb:align_to_major()
+    end
+end
