+-- A tap on a card outside the hand leaves its description open, with the finger off
+-- it. In the hand a tap selects the card, and the description is for a held finger.
+local function portrait_keeps_description(self, node)
+    if not (G.F_PORTRAIT and G.SETTINGS.tap_descriptions and self.HID.touch and node and node.is and node:is(Card)) then return false end
+    local kind = node.area and node.area.config and node.area.config.type
+    return kind and kind ~= 'hand' and kind ~= 'deck' and kind ~= 'discard'
+end
+
+-- One left open is there to be touched: a press on it closes it, and doesn't reach a
+-- button it hides (Next Round, in the shop).
+function Controller:portrait_press_on_description()
+    local popup = self.portrait_open_card and self.portrait_open_card.children.h_popup
+    return popup and self.HID.touch and popup:collides_with_point(self.cursor_hover.T)
+end
+
+function Controller:portrait_press_closes_description()
+    if self.portrait_open_card and self.cursor_down.target ~= self.portrait_open_card then
+        self.portrait_open_card = nil
+    end
+end
+
+function Controller:portrait_release_keeps_description()
+    self.portrait_tapped_card = nil
+    if self.clicked.handled then
+        -- A drag or a held finger, not a tap.
+        self.portrait_open_card = nil
+    elseif portrait_keeps_description(self, self.clicked.target) then
+        -- Until the tap is settled, so that the description opening under this
+        -- press does not close for a frame and open again.
+        self.portrait_tapped_card = self.clicked.target
+    end
+end
+
+function Controller:portrait_tap_toggles_description()
+    local card = self.portrait_tapped_card
+    if not card then return end
+    self.portrait_tapped_card = nil
+    if card.area and card.area:can_highlight(card) then
+        -- Open while the card is up with its buttons.
+        self.portrait_open_card = card.highlighted and card or nil
+        self.portrait_open_while_up = card.highlighted
+    else
+        self.portrait_open_card = self.portrait_open_card ~= card and card or nil
+        self.portrait_open_while_up = false
+    end
+end
+
+function Controller:portrait_hold_description_open()
+    if not self.HID.touch then return end
+    local open = self.portrait_open_card
+    if open and (open.REMOVED or not open.area or open.facing ~= 'front'
+            or not (open.states.hover.can and open.states.visible)
+            or (not not open.created_on_pause) ~= (not not G.SETTINGS.paused)
+            or (self.portrait_open_while_up and not open.highlighted)) then
+        open = nil
+        self.portrait_open_card = nil
+    end
+    local card = self.portrait_tapped_card or open
+    if card and not self.is_cursor_down then
+        self.hovering.target = card
+        card.states.hover.is = true
+    end
+end
